            <Field name="RD_w" source="Formula: if [RD] &gt; [Percentile_RD_99] then&#xA;[Percentile_RD_99]&#xA;&#xA;elseif [RD] &lt; [Percentile_RD_1] then&#xA;[Percentile_RD_1]&#xA;&#xA;else [RD]&#xA;&#xA;endif" type="Double" />
            <Field name="AD_w" source="Formula: if [AD] &gt; [Percentile_AD_99] then&#xA;[Percentile_AD_99]&#xA;&#xA;elseif [AD] &lt; [Percentile_AD_1] then&#xA;[Percentile_AD_1]&#xA;&#xA;else [AD]&#xA;&#xA;endif" type="Double" />
            <Field name="large_firm" source="Formula: if [at] &gt; [Median_at]&#xA;&#xA;then 1&#xA;else 0 &#xA;endif&#xA;&#xA;// Again, could also be IFF([at]&gt;[Median_at], 1, 0)" type="Int64" />
