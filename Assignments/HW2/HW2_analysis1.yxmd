            <Field name="E_w" source="Formula: if [E] &gt; [Percentile_E_99] then&#xA;[Percentile_E_99]&#xA;&#xA;elseif [E] &lt; [Percentile_E_1] then&#xA;[Percentile_E_1]&#xA;&#xA;else [E]&#xA;&#xA;endif" type="Double" />
